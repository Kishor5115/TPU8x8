#!/bin/sh

# ============================================================================
# TPU Project Environment Setup (template)
# ----------------------------------------------------------------------------
# Copy this file to `env.sh` and adjust the tool paths for your machine:
#
#     cp env.sh.example env.sh
#     # edit env.sh, then:
#     source env.sh
#
# `env.sh` is git-ignored so your local, machine-specific paths never get
# committed. Every variable below can also be overridden from your shell
# environment before sourcing (e.g. `OSS_CAD_PATH=/opt/oss-cad/bin source env.sh`).
#
# Compatible with both Bash and Zsh.
# ============================================================================

# ----------------------------------------------------------------------------
# Project Root (absolute path to this directory)
# ----------------------------------------------------------------------------
if [ -n "$BASH_VERSION" ]; then
    PROJECT_ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
elif [ -n "$ZSH_VERSION" ]; then
    PROJECT_ROOT=$(cd "$(dirname "${(%):-%x}")" && pwd)
else
    PROJECT_ROOT=$(pwd)
fi

# ----------------------------------------------------------------------------
# 1. PDK Configuration
# ----------------------------------------------------------------------------
export PDK_ROOT="${PDK_ROOT:-$PROJECT_ROOT/ihp13/pdk/ihp-sg13g2}"

# ----------------------------------------------------------------------------
# 2. Tool Paths  (EDIT THESE FOR YOUR MACHINE)
# ----------------------------------------------------------------------------
# Directory containing the OSS CAD Suite binaries (yosys, iverilog, ...).
# Download: https://github.com/YosysHQ/oss-cad-suite-build
export OSS_CAD_PATH="${OSS_CAD_PATH:-/opt/oss-cad-suite/bin}"

# Optional: a known-good KLayout build for IHP SG13G2 DRC/LVS decks.
# Leave empty to use whatever `klayout` is already on your PATH.
export KLAYOUT_BIN="${KLAYOUT_BIN:-}"

# Prefer the explicit KLayout build when one is provided and executable.
if [ -n "$KLAYOUT_BIN" ] && [ -x "$KLAYOUT_BIN/klayout" ]; then
    case ":$PATH:" in
        *":$KLAYOUT_BIN:"*) ;;
        *) export PATH="$KLAYOUT_BIN:$PATH" ;;
    esac
    export KLAYOUT="$KLAYOUT_BIN/klayout"
fi

# Prepend the OSS CAD Suite to PATH if it exists.
if [ -d "$OSS_CAD_PATH" ]; then
    case ":$PATH:" in
        *":$OSS_CAD_PATH:"*) ;;
        *) export PATH="$OSS_CAD_PATH:$PATH" ;;
    esac
fi

# ----------------------------------------------------------------------------
# 3. Convenience Aliases
# ----------------------------------------------------------------------------
alias tpugui='gtkwave sym/pre_synth/tpu_master.vcd'
alias tpuclean='make -C sym/pre_synth clean && make -C sym/post_synth clean'

echo "============================================================"
echo " TPU Environment Loaded!"
echo "   PROJECT_ROOT : $PROJECT_ROOT"
echo "   PDK_ROOT     : $PDK_ROOT"
echo "   Tools Path   : $OSS_CAD_PATH"
echo "============================================================"
